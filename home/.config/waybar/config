{
  "layer": "top",
  "position": "top",
  "height": 28,

  "margin-top": 6,
  "margin-left": 550,
  "margin-right": 550,
  "margin-bottom": 0,

  "spacing": 2,

  "reload_style_on_change": true,

  "modules-left": [
    "custom/menu",
    "clock"
  ],
  "modules-center": [
    "niri/workspaces"
  ],
  "modules-right": [
    "custom/weather",
    "pulseaudio",
    "battery",
    "network",
    "tray"
  ],

  "custom/menu": {
    "format": "󰹢",
    "on-click": "kuminmenu.sh",
    "tooltip-format": "Kumin Menu (Mod+Tab)"
  },

  "clock": {
    "format": "{:%a, %b %d  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "default": "•"
    }
  },

  "custom/weather": {
    "format": "󰖐 {}",
    "tooltip-format": "Weather: {}C",
    "exec": "curl -s 'wttr.in/?format=%t' 2>/dev/null | tr -d '+C'",
    "interval": 900
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "foot -e nmtui"
  },

  "tray": {
    "icon-size": 13,
    "spacing": 6
  }
}
